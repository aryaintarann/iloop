---
import { cta } from '../data/content';
---
<section class="cta-band" id="join">
  <div class="container cta-inner">
    <div><p class="section-label">A conversation about your property</p><h2>{cta.title}</h2></div>
    <div><p>{cta.description}</p><a class="button button-light" href="/contact/" data-cta-action="demo" data-cta-placement="cta-band">{cta.demoLabel}</a><a class="light-link" href="/contact/#early-access" data-cta-action="waitlist" data-cta-placement="cta-band-early-access">{cta.waitlistLabel}</a></div>
  </div>
</section>
