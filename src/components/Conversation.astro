---
import { conversation } from '../data/content';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<figure class:list={['conversation', { compact }]}>
  <figcaption class="conversation-heading"><span class="conversation-mark" aria-hidden="true">i</span><div><strong>{conversation.time}</strong><span>Illustrative guest conversation</span></div></figcaption>
  <div class="messages">
    <p class="message guest">{conversation.guestArrival}</p>
    <p class="message assistant">{conversation.assistantArrival}</p>
    {!compact && <p class="message guest">{conversation.guestCheckout}</p>}
    <p class="message assistant">{conversation.assistantHandover}</p>
  </div>
  <p class="handover">{conversation.handover}</p>
</figure>
