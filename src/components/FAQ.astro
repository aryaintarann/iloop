---
import { faqs } from '../data/content';
interface Props { limit?: number }
const { limit = faqs.length } = Astro.props;
---
<div class="faq-list">
  {faqs.slice(0, limit).map(faq => <details><summary>{faq.question}<span aria-hidden="true" class="faq-sign"></span></summary><p>{faq.answer}</p></details>)}
</div>
