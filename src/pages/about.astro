---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import { sections } from '../data/content';
---
<Layout title="About Our Hotel AI Assistant | iloop.id" description="Learn about iloop.id, an AI guest communication assistant for hotel teams in Indonesia, and our approach to hotel information, setup and staff handover.">
  <section class="page-intro container">
    <p class="section-label">About</p>
    <h1>About <span>iloop.id</span></h1>
    <p class="lead">{sections.introduction.description}</p>
  </section>
  <section class="section container integration-section">
    <div><p class="section-label">Our approach</p><h2>Start with your<br />hotel’s information.</h2></div>
    <div><p class="lead">We work with your team to set up the assistant using the rooms, policies, services and FAQs you provide.</p><p>Your team can update that information, review the full conversation history and decide when to step in. During a demo, we discuss your channels and check the fit with your PMS or booking engine.</p><a class="text-link" href="/how-it-works/">See how setup works</a></div>
  </section>
  <section class="direct-contact container">
    <div><p class="section-label">Talk to us</p><a class="email-address" href="mailto:hello@iloop.id">hello@iloop.id</a></div>
    <p>Tell us about your hotel and the questions your guests ask. We can walk through the product with you and discuss a pilot for your property.</p>
  </section>
  <CTA />
</Layout>
