---
import { Picture } from 'astro:assets';
import hotel from '../assets/hotel-room.jpg';
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import FAQ from '../components/FAQ.astro';
import { sections, setup, journey } from '../data/content';
---
<Layout title="How Our Hotel AI Assistant Works | iloop.id" description="Set up iloop.id with your hotel information, WhatsApp, website chat and email. Learn how guest replies, staff handover and PMS fit checks work.">
  <section class="page-intro container"><p class="section-label">How it works</p><h1>How iloop.id works <span>with your hotel</span></h1><p class="lead">We set up iloop.id with hotel teams in Indonesia using the rooms, policies, services and FAQs they provide. The AI assistant replies on WhatsApp, website chat and email, and staff can take over with the conversation history.</p></section>
  <section class="setup-section container" id="how"><div><p class="section-label">Getting your hotel connected</p><h2>{sections.setup.title}</h2><Picture src={hotel} alt="Warm hotel room with white bedding and a lamp beside the bed" formats={['avif', 'webp']} widths={[480, 800]} sizes="(min-width: 768px) 40vw, 100vw" class="setup-photo" /></div><ol class="setup-list">{setup.map((step, i) => <li><span class="index">0{i + 1}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></li>)}</ol></section>
  <section class="journey-section" id="journey"><div class="container"><div class="section-heading"><div><p class="section-label">The guest journey</p><h2>{sections.journey.title}</h2></div><p class="lead">A useful message at each stage, with a person ready to step in whenever the conversation needs one.</p></div><ol class="journey-list">{journey.map((stage, i) => <li><span class="index">0{i + 1}</span><h3>{stage.title}</h3><p>{stage.description}</p></li>)}</ol></div></section>
  <section class="section container integration-section" id="integrations"><div><p class="section-label">Your existing systems</p><h2>{sections.channels.title}</h2></div><div><p class="lead">{sections.channels.description}</p><p>Tell us which systems you use. We’ll confirm the fit and discuss the setup for your property.</p><a class="text-link" href="/contact/">Discuss your setup</a></div></section>
  <section class="faq-section container" id="faq"><div><p class="section-label">Questions hotels ask</p><h2>{sections.faq.title}</h2></div><FAQ /></section>
  <CTA />
</Layout>
