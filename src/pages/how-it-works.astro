---
import { Picture } from 'astro:assets';
import hotel from '../assets/hotel-room.jpg';
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import FAQ from '../components/FAQ.astro';
import { setup, journey } from '../data/content';
---
<Layout title="How it works | Set up your hotel assistant | iloop.id" description="Connect your channels, add your hotel information and let iloop.id support the guest journey. See setup, integrations and answers to hotel FAQs.">
  <section class="page-intro container"><p class="section-label">How it works</p><h1>A part of your team.<br /><span>Across the whole stay.</span></h1><p class="lead">We build the setup around your hotel’s information, your communication channels and the way your team works.</p></section>
  <section class="setup-section container" id="how"><div><p class="section-label">Getting your hotel connected</p><h2>Start with what<br />your guests need.</h2><Picture src={hotel} alt="Warm hotel room with white bedding and a lamp beside the bed" formats={['avif', 'webp']} widths={[480, 800]} sizes="(min-width: 768px) 40vw, 100vw" class="setup-photo" /></div><ol class="setup-list">{setup.map((step, i) => <li><span class="index">0{i + 1}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></li>)}</ol></section>
  <section class="journey-section" id="journey"><div class="container"><div class="section-heading"><div><p class="section-label">The guest journey</p><h2>Care that continues<br />beyond check-in.</h2></div><p class="lead">A useful message at each stage, with a person ready to step in whenever the conversation needs one.</p></div><ol class="journey-list">{journey.map((stage, i) => <li><span class="index">0{i + 1}</span><h3>{stage.title}</h3><p>{stage.description}</p></li>)}</ol></div></section>
  <section class="section container integration-section" id="integrations"><div><p class="section-label">Your existing systems</p><h2>Built to work<br />alongside your hotel.</h2></div><div><p class="lead">iloop.id is designed to work alongside your booking engine and property management system.</p><p>Tell us which systems you use. We’ll confirm the fit and discuss the setup for your property.</p><a class="text-link" href="/contact/">Discuss your setup</a></div></section>
  <section class="faq-section container" id="faq"><div><p class="section-label">Questions hotels ask</p><h2>Let’s clear up<br />the details.</h2></div><FAQ /></section>
  <CTA />
</Layout>
