---
import { Picture } from 'astro:assets';
import hotel from '../assets/hotel-room.jpg';
import Layout from '../layouts/Layout.astro';
import Conversation from '../components/Conversation.astro';
import CTA from '../components/CTA.astro';
import FAQ from '../components/FAQ.astro';
import { homepage, sections, benefits, features, setup, journey } from '../data/content';
---
<Layout title={homepage.title} description={homepage.description}>
  <section class="home-hero container">
    <div class="hero-copy">
      <p class="section-label">{homepage.eyebrow}</p>
      <h1>{homepage.headline} <span>{homepage.headlineAccent}</span></h1>
      <p class="lead">{homepage.lead}</p>
      <div class="actions"><a class="button" href="/contact/" data-cta-action="demo" data-cta-placement="home-hero">Book a demo</a><a class="text-link" href="/features/">{homepage.featureLink}</a></div>
      <p class="hero-footnote">{homepage.footnote}</p>
    </div>
    <div class="hero-scene">
      <Picture src={hotel} alt="A welcoming hotel room with a neatly made bed, warm wood panelling and a bedside lamp" formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(min-width: 1200px) 600px, (min-width: 768px) 50vw, 100vw" loading="eager" fetchpriority="high" class="hero-photo" />
      <Conversation compact />
    </div>
  </section>

  <div class="channel-strip" id="channels"><div class="container"><p>{sections.channels.title}</p><ul><li>WhatsApp</li><li>Website chat</li><li>Email</li></ul></div></div>

  <section class="section container" id="about">
    <div class="section-heading"><div><p class="section-label">{sections.outcomes.title}</p><h2>{sections.introduction.title}</h2></div><p class="lead">{sections.introduction.description}</p></div>
    <div class="benefit-grid" id="outcomes">
      {benefits.map((benefit, i) => <article><span class="index">0{i + 1}</span><h3>{benefit.title}</h3><p>{benefit.description}</p></article>)}
    </div>
  </section>

  <section class="feature-summary" id="features"><div class="container">
    <div class="section-heading"><div><p class="section-label">Built around the stay</p><h2>{sections.features.title}</h2></div><a class="text-link" href="/features/">View all features</a></div>
    <div class="summary-list">{features.map((feature, i) => <a href={`/features/#${feature.id}`}><span class="index">0{i + 1}</span><h3>{feature.title}</h3><span class="summary-description">{feature.description}</span><span class="link-arrow" aria-hidden="true">↗</span></a>)}</div>
  </div></section>

  <section class="section container home-process" id="how">
    <div><p class="section-label">Made to work with your hotel</p><h2>{sections.setup.title}</h2><p class="lead">{sections.channels.description}</p><a class="text-link" href="/how-it-works/">See how it works</a></div>
    <ol class="setup-list">{setup.map((step, i) => <li><span class="index">0{i + 1}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></li>)}</ol>
  </section>

  <section class="journey-summary" id="journey"><div class="container"><p class="section-label">{sections.journey.title}</p><ul>{journey.map(stage => <li>{stage.title}</li>)}</ul></div></section>

  <section class="section container control-summary" id="security"><div><p class="section-label">Stay in control</p><h2>{sections.security.title}</h2></div><div><p class="lead">{sections.security.description}</p><a class="text-link" href="/features/#security">Team control &amp; security</a><p class="report-summary" id="results">{sections.reporting.description} <a href="/features/#results">View the illustrative reporting example</a>.</p></div></section>

  <section class="faq-section container" id="faq"><div><p class="section-label">Before we talk</p><h2>{sections.faq.title}</h2><a class="text-link" href="/how-it-works/#faq">Read all FAQs</a></div><FAQ limit={3} /></section>
  <CTA />
</Layout>
